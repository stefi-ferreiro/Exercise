{
  "name": "MathVoice Design System",
  "install": "cd mathvoice-design-system && npm ci",
  "terminals": [
    {
      "name": "ng serve",
      "command": "cd mathvoice-design-system && npx ng serve --host 0.0.0.0 --port 4200",
      "description": "Angular dev server for the MathVoice catalogue at http://localhost:4200"
    }
  ],
  "ports": [
    {
      "name": "catalogue",
      "port": 4200
    }
  ]
}
